@model WebApplication1.Models.LoginViewModel

@{
    Layout = null; // exclude header/footer if you want
}

<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body style="background-color:#d6d6d6; margin:0;">
    <div class="container-fluid vh-100">
        <div class="row h-100">
            <!-- Left side: Image (70%) -->
            <div class="col-md-8 d-none d-md-block p-0" style="flex:0 0 70%; max-width:70%;">
                <img src="~/image/loginbg.jpg"
                     alt="Login background"
                     style="width:100%; height:100%; object-fit:cover;" />
            </div>

            <!-- Right side: Login card (30%) -->
            <div class="col-md-4 d-flex justify-content-center align-items-center" style="flex:0 0 30%; max-width:30%;">
                <div class="card border shadow" style="width:100%; max-width:400px;">
                    <div class="card-body">
                        <h4 class="card-title text-center mb-4">Login</h4>
                        <form asp-action="Login" method="post">
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" class="form-control" type="password" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-secondary">Submit</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>