@{
    ViewData["Home"] = "Home Page";
}
<body style="margin:0; font-family:Arial, sans-serif; background:url('/image/home.jpg') no-repeat center center fixed; background-size:cover; color:#000;">

  <section style="text-align:left; margin-top:120px;">
        <h1 style="font-size:3.5em; font-weight:bold;">Tosh to the World.</h1>
        <p style="margin-top:20px; font-size:1.2em; color:#333;">
            Welcome to my tourism hub — your gateway to breathtaking destinations,<br />
            cultural landmarks, and unforgettable experiences. Whether you’re seeking
            <br />adventure, relaxation, or a journey through history, this page is <br />designed
            to inspire your next travel story.
        </p>
  </section>
<section style="text-align:left; margin-top:20px;">
        <button style="background:transparent; border:0.5px solid #000; padding:12px 30px; font-size:1em; font-weight:bold; cursor:pointer; border-radius:10px; color:#000;">
            Get Started
        </button>
</section>

  
</body>
